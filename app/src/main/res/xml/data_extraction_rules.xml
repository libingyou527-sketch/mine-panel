<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- 云备份：全部排除；本应用数据只存本地，不参与任何云端恢复 -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <!-- 设备迁移（本地换机拷贝）：默认排除；加密导出在设置页显式开启后才产生文件 -->
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
